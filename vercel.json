{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/products.js": {
      "maxDuration": 10
    },
    "api/publish.js": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
